// Reglas de seguridad de Firebase Storage para VoxkyStudio.
// Permiten lectura pública y subida en "referencias", "proyectos" y "biblioteca" de hasta 100 MB.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /referencias/{proyectoId}/{nombreArchivo} {
      allow read, delete: if true;
      allow write: if request.resource != null
                   && request.resource.size <= 100 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('audio/.*')
                     || request.resource.contentType.matches('video/.*')
                     || request.resource.contentType.matches('application/octet-stream')
                     || nombreArchivo.matches('.*\\.(jpg|jpeg|png|webp|mp3|wav|m4a|mp4|mov|webm)$')
                   );
    }
    match /biblioteca/{nombreArchivo} {
      allow read, delete: if true;
      allow write: if request.resource != null
                   && request.resource.size <= 100 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('audio/.*')
                     || request.resource.contentType.matches('video/.*')
                     || request.resource.contentType.matches('application/octet-stream')
                     || nombreArchivo.matches('.*\\.(jpg|jpeg|png|webp|mp3|wav|m4a|mp4|mov|webm)$')
                   );
    }
    match /proyectos/{proyectoId}/{tipoCarpeta}/{nombreArchivo} {
      allow read, delete: if true;
      allow write: if request.resource != null
                   && request.resource.size <= 100 * 1024 * 1024;
    }
  }
}

// Reglas de seguridad de Firebase Storage para VoxkyStudio.
// Permiten lectura pública y subida de imágenes, audios (.mp3, .wav, .m4a) y videos (.mp4, .mov, .webm) de hasta 100 MB.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /referencias/{proyectoId}/{nombreArchivo} {
      allow read: if true;
      allow write: if request.resource != null
                   && request.resource.size <= 100 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('audio/.*')
                     || request.resource.contentType.matches('video/.*')
                     || request.resource.contentType.matches('application/octet-stream')
                     || nombreArchivo.matches('.*\\.(jpg|jpeg|png|webp|mp3|wav|m4a|mp4|mov|webm)$')
                   );
    }
  }
}

# ==============================================================================
# PLANTILLA DE VARIABLES SECRETAS (.env.example)
# Copia este archivo como ".env" y rellena tus claves reales.
# NUNCA compartas ni subas tu archivo ".env" a internet.
# ==============================================================================

# 1. Llave secreta de fal.ai (Solo la usa el servidor a través de /api/fal/proxy)
FAL_KEY=tu_clave_secreta_de_fal_ai_aqui

# 2. Configuración de tu proyecto de Firebase (Firestore y Storage)
# Estos valores los obtienes en la Consola de Firebase -> Configuración del proyecto
NEXT_PUBLIC_FIREBASE_API_KEY=tu_api_key_de_firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=id_de_tu_proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu_proyecto.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=tu_app_id
